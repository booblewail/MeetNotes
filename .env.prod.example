# Domains & TLS (used by Caddy + CORS + Next.js build args)
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
ACME_EMAIL=you@yourdomain.com

# Database (internal Docker Compose service "postgres")
POSTGRES_USER=meetnotes
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=meetnotes

# Auth (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-strong-32-byte-random-hex
JWT_EXPIRE_MINUTES=10080

# Live Speech-to-Text (Deepgram Nova-3)
DEEPGRAM_API_KEY=your_deepgram_key

# Gemini Models
GEMINI_API_KEY=your_gemini_key
LLM_FAST_MODEL=gemini-3.5-flash-lite
LLM_CONSOLIDATION_MODEL=gemini-4-hydrogen
EMBEDDING_MODEL=gemini-embedding-001

# Object Storage — Recommended: Cloudflare R2 (or AWS S3)
# Example R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_r2_access_key_id
S3_SECRET_KEY=your_r2_secret_access_key
S3_BUCKET_NAME=meetnotes-audio
S3_REGION=auto
