# Database & Cache
POSTGRES_USER=meetnotes
POSTGRES_PASSWORD=meetnotes_dev
POSTGRES_DB=meetnotes

# Security
JWT_SECRET_KEY=replace-with-strong-random-hex
JWT_EXPIRE_MINUTES=10080

# Speech-to-Text (Deepgram Nova-3)
DEEPGRAM_API_KEY=your_deepgram_key

# LLM Structuring & Embeddings (Gemini)
GEMINI_API_KEY=your_gemini_key
LLM_FAST_MODEL=gemini-3.5-flash-lite
LLM_CONSOLIDATION_MODEL=gemini-4-hydrogen
EMBEDDING_MODEL=gemini-embedding-001

# Object Storage (Local MinIO -> Prod Cloudflare R2 / S3)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=meetnotes-audio
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
